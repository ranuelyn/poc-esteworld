{
  "name": "esteworld-ai-sales-assistant-poc",
  "version": "0.1.0",
  "description": "On-premise AI sales assistant PoC for healthcare tourism with BullMQ, Qdrant, and Ollama.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:api": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/infrastructure/queue/chatWorker.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/infrastructure/queue/chatWorker.js",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "seed": "tsx src/scripts/seedFakeDialogues.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.17.0",
    "bullmq": "^5.76.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
